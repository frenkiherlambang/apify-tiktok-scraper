{
  "actorSpecification": 1,
  "name": "tiktok-scraper",
  "title": "TikTok Scraper",
  "description": "Scrape TikTok search results, hashtags, and profiles using session cookies with network interception. Captures 100+ items per query via scroll pagination.",
  "version": "1.0",
  "meta": {
    "template": "project-playwright"
  },
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {
        "post_id": {
          "type": "string",
          "description": "Unique TikTok video ID."
        },
        "text": {
          "type": "string",
          "description": "Video caption/description text."
        },
        "post_url": {
          "type": "string",
          "description": "Direct link to the TikTok video."
        },
        "likes": {
          "type": "integer",
          "description": "Number of likes."
        },
        "views": {
          "type": "integer",
          "description": "Number of plays."
        }
      }
    }
  },
  "environmentVariables": {}
}
